limit_req_zone $binary_remote_addr zone=github_hooks:1m rate=10r/s;
server {
    listen 80;
    server_name __DOMAIN__;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 503; }
}
server {
    listen 443 ssl;
    server_name __DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    client_body_timeout 10s;
    location ^~ /github/webhook/ {
        limit_except POST { deny all; }
        limit_req zone=github_hooks burst=50 nodelay;
        limit_req_status 429;
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $hook_backend http://__SERVICE__:8080;
        proxy_pass $hook_backend;
        proxy_connect_timeout 2s;
        proxy_read_timeout 8s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / { return 404; }
}
