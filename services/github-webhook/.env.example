# Publish a tested immutable image before enabling this optional service.
GITHUB_WEBHOOK_IMAGE=ghcr.io/redeployment/xdocker-github-webhook:REPLACE_WITH_PUBLISHED_TAG
GITHUB_WEBHOOK_PULL_POLICY=missing
# Set by scripts/github-webhook.sh init; same private queue owner as admin.
GITHUB_WEBHOOK_UID=1000
GITHUB_WEBHOOK_GID=1000
