ADMIN_IMAGE=ghcr.io/redeployment/xdocker-admin:REPLACE_WITH_PUBLISHED_TAG
ADMIN_PULL_POLICY=missing
ADMIN_PORT=9080
# admin.sh init detects the config owner and host Docker socket group.
ADMIN_UID=1000
ADMIN_GID=1000
ADMIN_DOCKER_GID=999
ADMIN_DEPLOY_REVISION=unknown
ADMIN_HOST_ROOT=
# Explicit runtime opt-in. Per-instance plans remain disabled until saved and confirmed in UI.
ADMIN_BACKUP_SCHEDULER_ENABLED=false
# Read-only GitHub observer. Default off; configure private GitHub App credentials, then opt in once.
# Enabled: automatic startup history, event-triggered refresh and periodic fallback.
ADMIN_GITHUB_WATCH_ENABLED=false
ADMIN_GITHUB_WATCH_INTERVAL=300

# Import signed events from the isolated queue (disk only; no GitHub API requests).
ADMIN_GITHUB_WEBHOOK_ENABLED=false
