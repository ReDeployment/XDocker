# Space-separated site keys under sites/. Only verified PowerXDoc is enabled initially.
ENABLED_SITES="powerxdoc"
NGINX_IMAGE=nginx:alpine
CERTBOT_IMAGE=certbot/certbot:latest
CERTBOT_EMAIL=replace-with-your-email@example.com
# Local debugging: bind to 127.0.0.1, use ports 8080 and 8443.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
