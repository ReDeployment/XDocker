# Space-separated site keys under sites/. Only verified PowerXDoc is enabled initially.
ENABLED_SITES="powerxdoc"
ENABLED_SERVICES=""
# Optional infrastructure: "frps admin portainer github-webhook". Management UIs use SSH tunnels.
NGINX_IMAGE=nginx:alpine
CERTBOT_IMAGE=certbot/certbot:latest
# After explicitly pulling/loading both images, use never to run from local cache.
# A never policy fails immediately if the configured image is not present locally.
NGINX_PULL_POLICY=missing
CERTBOT_PULL_POLICY=missing
CERTBOT_EMAIL=replace-with-your-email@example.com
# Existing certificates can be inspected with LETSENCRYPT_DIR=/etc/letsencrypt.
# Use only one renewal scheduler for each writable certificate directory.
LETSENCRYPT_DIR=./data/letsencrypt
CERTIFICATES_INVENTORY=./certbot/certificates.json
# Local debugging: bind to 127.0.0.1, use ports 8080 and 8443.
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
# Deployment public IP configuration: expected A/AAAA addresses, separated by spaces.
# Set actual server addresses only in private .env; never put them in this template.
# IPv4 first, then any actually deployed IPv6 addresses.
# Used by Admin DNS checks; never sets container listen addresses or changes DNS.
# Leave empty only to report DNS targets as not verified.
PREFLIGHT_EXPECTED_IPS=""
# XDocker-maintained published-version records; empty until the maintainer registers verified artifacts.
POWERX_VERSION_CATALOG=./apps/powerx/versions.json
